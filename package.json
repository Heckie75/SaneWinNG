{
  "name": "sanewin-ng",
  "version": "0.5.0",
  "description": "A modern desktop client for SANE scanners",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist:win": "electron-builder --win"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@img/sharp-wasm32": "0.35.5",
    "bonjour-service": "^1.4.4",
    "lucide-static": "^0.468.0",
    "pdf-lib": "^1.17.1",
    "pngjs": "^7.0.0",
    "sharp": "0.35.5",
    "skew-score": "1.1.1"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "org.sanewinng.app",
    "productName": "SaneWin NG",
    "files": [
      "src/**/*",
      "node_modules/lucide-static/icons/*"
    ],
    "asarUnpack": [
      "node_modules/@img/sharp-wasm32/**/*"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
